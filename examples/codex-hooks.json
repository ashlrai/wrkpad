{
  "description": "Observe Codex session state for local wrkpad status.",
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
      "hooks": [{"type": "command", "command": "/absolute/path/to/wrkpad hook --provider codex", "timeout": 2}]
    }],
    "UserPromptSubmit": [{
      "hooks": [{"type": "command", "command": "/absolute/path/to/wrkpad hook --provider codex", "timeout": 2}]
    }],
    "PermissionRequest": [{
      "matcher": "*",
      "hooks": [{"type": "command", "command": "/absolute/path/to/wrkpad hook --provider codex", "timeout": 2}]
    }],
    "PostToolUse": [{
      "hooks": [{"type": "command", "command": "/absolute/path/to/wrkpad hook --provider codex", "timeout": 2}]
    }],
    "Stop": [{
      "hooks": [{"type": "command", "command": "/absolute/path/to/wrkpad hook --provider codex", "timeout": 2}]
    }]
  }
}

