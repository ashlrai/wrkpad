{
  "name": "ashlr-agent-board",
  "private": true,
  "version": "0.1.0",
  "author": "Ashlr AI",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ashlrai/wrkpad/tree/main/app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashlrai/wrkpad.git",
    "directory": "app"
  },
  "bugs": {
    "url": "https://github.com/ashlrai/wrkpad/issues"
  },
  "keywords": [
    "agentic-engineering",
    "claude-code",
    "codex",
    "creator-micro-2",
    "developer-tools",
    "electron",
    "work-louder"
  ],
  "engines": {
    "node": ">=22"
  },
  "description": "A local-first agent mission control for the Work Louder Creator Micro 2.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "doctor": "node scripts/doctor.mjs",
    "profile:generate": "node scripts/generate-input-profile.mjs",
    "build": "tsc -b && vite build",
    "capture:public-demo": "npm run build && electron scripts/capture-public-demo.cjs",
    "lint": "oxlint src electron scripts vite.config.ts vitest.config.ts",
    "test": "vitest run && node --test electron/*.test.cjs scripts/*.test.mjs",
    "preview": "vite preview",
    "start": "electron .",
    "package:mac": "npm run build && electron-builder --mac dir"
  },
  "build": {
    "appId": "ai.ashlr.agent-board",
    "productName": "Ashlr Agent Board",
    "afterPack": "scripts/after-pack.cjs",
    "directories": { "output": "release" },
    "files": ["dist-renderer/**/*", "electron/**/*", "!electron/*.test.cjs", "package.json", "LICENSE", "NOTICE"],
    "mac": { "category": "public.app-category.developer-tools", "target": "dir", "icon": "build/icon.png" }
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
